<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">

  <!--
  @file coug_waypoints_config.ui
  @brief UI for the CougWaypointsPlugin.
  @author Nelson Durrant
  @date May 2026
  -->

  <class>coug_waypoints_config</class>
  <widget class="QWidget" name="coug_waypoints_config">
    <property name="geometry">
      <rect>
        <x>0</x>
        <y>0</y>
        <width>280</width>
        <height>410</height>
      </rect>
    </property>

    <property name="windowTitle">
      <string>Form</string>
    </property>
    <property name="styleSheet">
      <string notr="true" />
    </property>
    <layout class="QGridLayout" name="gridLayout">
      <property name="leftMargin">
        <number>2</number>
      </property>
      <property name="topMargin">
        <number>2</number>
      </property>
      <property name="rightMargin">
        <number>2</number>
      </property>
      <property name="bottomMargin">
        <number>2</number>
      </property>
      <property name="verticalSpacing">
        <number>6</number>
      </property>

      <!-- Row 0: Agent Selection -->
      <item row="0" column="0">
        <widget class="QLabel" name="label_agent">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Agent:</string>
          </property>
        </widget>
      </item>
      <item row="0" column="1" colspan="3">
        <widget class="QComboBox" name="agent_selector">
          <property name="editable">
            <bool>false</bool>
          </property>
        </widget>
      </item>

      <!-- Row 1: Latitude Adjustment -->
      <item row="1" column="0">
        <widget class="QLabel" name="label_lat">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Latitude:</string>
          </property>
        </widget>
      </item>
      <item row="1" column="1" colspan="3">
        <widget class="QDoubleSpinBox" name="lat_editor">
          <property name="enabled">
            <bool>false</bool>
          </property>
          <property name="decimals">
            <number>8</number>
          </property>
          <property name="minimum">
            <double>-90.0</double>
          </property>
          <property name="maximum">
            <double>90.0</double>
          </property>
          <property name="singleStep">
            <double>0.00001</double>
          </property>
          <property name="buttonSymbols">
            <enum>QAbstractSpinBox::PlusMinus</enum>
          </property>
        </widget>
      </item>

      <!-- Row 2: Longitude Adjustment -->
      <item row="2" column="0">
        <widget class="QLabel" name="label_lon">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Longitude:</string>
          </property>
        </widget>
      </item>
      <item row="2" column="1" colspan="3">
        <widget class="QDoubleSpinBox" name="lon_editor">
          <property name="enabled">
            <bool>false</bool>
          </property>
          <property name="decimals">
            <number>8</number>
          </property>
          <property name="minimum">
            <double>-180.0</double>
          </property>
          <property name="maximum">
            <double>180.0</double>
          </property>
          <property name="singleStep">
            <double>0.00001</double>
          </property>
          <property name="buttonSymbols">
            <enum>QAbstractSpinBox::PlusMinus</enum>
          </property>
        </widget>
      </item>

      <!-- Row 3: Selected Depth -->
      <item row="3" column="0">
        <widget class="QLabel" name="label_selected">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Depth (m):</string>
          </property>
        </widget>
      </item>
      <item row="3" column="1" colspan="3">
        <widget class="QDoubleSpinBox" name="depth_editor">
          <property name="enabled">
            <bool>false</bool>
          </property>
          <property name="decimals">
            <number>2</number>
          </property>
          <property name="minimum">
            <double>-9999.990000000000009</double>
          </property>
          <property name="maximum">
            <double>0.0</double>
          </property>
          <property name="buttonSymbols">
            <enum>QAbstractSpinBox::PlusMinus</enum>
          </property>
        </widget>
      </item>

      <!-- Row 4: Altitude Control Checkbox -->
      <item row="4" column="1" colspan="3">
        <widget class="QCheckBox" name="altitude_mode">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Altitude control (ALT)</string>
          </property>
          <property name="enabled">
            <bool>false</bool>
          </property>
        </widget>
      </item>

      <!-- Row 5: Selected Speed -->
      <item row="5" column="0">
        <widget class="QLabel" name="label_speed">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Speed (RPM):</string>
          </property>
        </widget>
      </item>
      <item row="5" column="1" colspan="3">
        <widget class="QDoubleSpinBox" name="speed_editor">
          <property name="enabled">
            <bool>false</bool>
          </property>
          <property name="decimals">
            <number>1</number>
          </property>
          <property name="minimum">
            <double>0.0</double>
          </property>
          <property name="maximum">
            <double>1525.0</double>
          </property>
          <property name="value">
            <double>1500.0</double>
          </property>
          <property name="buttonSymbols">
            <enum>QAbstractSpinBox::PlusMinus</enum>
          </property>
        </widget>
      </item>

      <!-- Row 6: Capture Radius -->
      <item row="6" column="0">
        <widget class="QLabel" name="label_capture">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Capture (m):</string>
          </property>
        </widget>
      </item>
      <item row="6" column="1" colspan="3">
        <widget class="QDoubleSpinBox" name="capture_radius_editor">
          <property name="enabled">
            <bool>false</bool>
          </property>
          <property name="decimals">
            <number>1</number>
          </property>
          <property name="minimum">
            <double>0.1</double>
          </property>
          <property name="maximum">
            <double>9999.990000000000009</double>
          </property>
          <property name="value">
            <double>25.0</double>
          </property>
          <property name="buttonSymbols">
            <enum>QAbstractSpinBox::PlusMinus</enum>
          </property>
        </widget>
      </item>

      <!-- Row 7: Slip Radius -->
      <item row="7" column="0">
        <widget class="QLabel" name="label_slip">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Slip (m):</string>
          </property>
        </widget>
      </item>
      <item row="7" column="1" colspan="3">
        <widget class="QDoubleSpinBox" name="slip_radius_editor">
          <property name="enabled">
            <bool>false</bool>
          </property>
          <property name="decimals">
            <number>1</number>
          </property>
          <property name="minimum">
            <double>0.1</double>
          </property>
          <property name="maximum">
            <double>9999.990000000000009</double>
          </property>
          <property name="value">
            <double>50.0</double>
          </property>
          <property name="buttonSymbols">
            <enum>QAbstractSpinBox::PlusMinus</enum>
          </property>
        </widget>
      </item>

      <!-- Row 8: Separator -->
      <item row="8" column="1" colspan="3">
        <widget class="QFrame" name="separator_top">
          <property name="frameShape">
            <enum>QFrame::HLine</enum>
          </property>
          <property name="frameShadow">
            <enum>QFrame::Sunken</enum>
          </property>
        </widget>
      </item>

      <!-- Row 9: Publish / Clear -->
      <item row="9" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_pub_clear">
          <item>
            <widget class="QPushButton" name="publish">
              <property name="text">
                <string>Publish</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="clear">
              <property name="text">
                <string>Clear</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 10: Load / Save -->
      <item row="10" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_file">
          <item>
            <widget class="QPushButton" name="load">
              <property name="text">
                <string>Load</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="save">
              <property name="text">
                <string>Save</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 11: Separator -->
      <item row="11" column="1" colspan="3">
        <widget class="QFrame" name="separator">
          <property name="frameShape">
            <enum>QFrame::HLine</enum>
          </property>
          <property name="frameShadow">
            <enum>QFrame::Sunken</enum>
          </property>
        </widget>
      </item>

      <!-- Row 12: Start / Stop -->
      <item row="12" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_start_stop">
          <item>
            <widget class="QPushButton" name="start">
              <property name="text">
                <string>Start</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="stop">
              <property name="text">
                <string>Stop</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 13: Surface / Home -->
      <item row="13" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_surface_home">
          <item>
            <widget class="QPushButton" name="home">
              <property name="text">
                <string>Home</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="surface">
              <property name="text">
                <string>Surface</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 14: Checkbox -->
      <item row="14" column="1" colspan="3">
        <widget class="QCheckBox" name="apply_all">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Apply to all agents</string>
          </property>
          <property name="checked">
            <bool>true</bool>
          </property>
        </widget>
      </item>

      <!-- Row 15: Status -->
      <item row="15" column="0">
        <widget class="QLabel" name="label_2">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="text">
            <string>Status:</string>
          </property>
        </widget>
      </item>
      <item row="15" column="1" colspan="3">
        <widget class="QLabel" name="status">
          <property name="font">
            <font>
              <family>Sans Serif</family>
              <pointsize>8</pointsize>
            </font>
          </property>
          <property name="styleSheet">
            <string notr="true" />
          </property>
          <property name="text">
            <string>Click to add waypoints</string>
          </property>
          <property name="wordWrap">
            <bool>true</bool>
          </property>
          <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
          </property>
        </widget>
      </item>

    </layout>
  </widget>

  <resources />
  <connections />
</ui>
